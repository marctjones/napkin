<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Napkin.Tools</RootNamespace>

    <!-- Repository tooling, never shipped or packaged with the app. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No PackageReference by design: this tool uses the BCL only. -->

</Project>
