<Project Sdk="Microsoft.NET.Sdk">

  <!-- The live host for GUI scenarios (#151, docs/testing/live-scenarios.md): runs a scenario from
       the GUI suite in a real, visible napkin window, paced so a person can watch it. A tool for a
       person at a desk: CI builds it with the solution and never runs it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Napkin.Demo</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <!-- The GuiTests reference brings xunit.v3's build assets; this is a program, not a test runner. -->
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <GenerateSelfRegisteredExtensions>false</GenerateSelfRegisteredExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Napkin.App\Napkin.App.csproj" />
    <!-- The scenarios, IGuiDriver and the pacing arithmetic live with the headless suite, so one
         scenario body serves both hosts. -->
    <ProjectReference Include="..\..\tests\Napkin.App.GuiTests\Napkin.App.GuiTests.csproj" />
  </ItemGroup>

</Project>
