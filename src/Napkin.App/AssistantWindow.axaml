<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="700"
        x:Class="Napkin.App.AssistantWindow"
        Title="Where the model runs"
        Icon="/Assets/napkin-256.png"
        Width="600" Height="720"
        MinWidth="420" MinHeight="420">

    <!--
        Where the assistant's model runs (docs/design/llm-assistant.md §5.4, §5.5, §6.1, §8, issue
        #231): none, or a program the person installed on this machine — Ollama, or llama.cpp's
        llama-server — at a loopback address. The list is what the program reports, as read; napkin
        guesses nothing from a name and downloads nothing. Not modal, like the code window.
    -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14" Spacing="8">
            <TextBlock Text="Where the assistant's model runs" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />

            <RadioButton Name="NoneRadio" GroupName="Provider" FontSize="12"
                         Content="None — the assistant says how to add a model"
                         IsCheckedChanged="OnProviderChanged" />
            <RadioButton Name="LocalRadio" GroupName="Provider" FontSize="12"
                         Content="A program on this machine: Ollama, or llama.cpp's llama-server"
                         IsCheckedChanged="OnProviderChanged" />

            <StackPanel Name="LocalPanel" Spacing="6" Margin="22,0,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="Address" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Name="AddressBox" FontSize="12" AutomationProperties.Name="Address" />
                    <Button Grid.Column="2" Name="CheckButton" Content="Check" FontSize="12" Margin="8,0,0,0" Click="OnCheckClicked"
                            ToolTip.Tip="Ask the program on this machine which models it has." />
                </Grid>
                <TextBlock Name="AddressHintText" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock Name="CheckText" FontSize="11" TextWrapping="Wrap" IsVisible="False" AutomationProperties.Name="What the program said" />
                <ListBox Name="ModelList" SelectionMode="Single" MaxHeight="150"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Models on this machine"
                         SelectionChanged="OnModelChosen">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Name="MemoryText" FontSize="11" Opacity="0.8" TextWrapping="Wrap" AutomationProperties.Name="Memory" />
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Text="Model" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Grid.Column="1" Name="ModelBox" FontSize="12" PlaceholderText="qwen3:4b-q4_K_M" AutomationProperties.Name="Model" />
                    <TextBlock Grid.Column="2" Text="Temperature" FontSize="12" VerticalAlignment="Center" Margin="12,0,8,0" />
                    <TextBox Grid.Column="3" Name="TemperatureBox" FontSize="12" Width="60" AutomationProperties.Name="Temperature" />
                </Grid>
                <TextBlock Name="TemperatureHintText" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Name="TestButton" Content="Test" FontSize="12" Click="OnTestClicked"
                            ToolTip.Tip="Ask the model to reply &quot;ok&quot; and say how long the round trip took. Nothing about the design is sent." />
                    <TextBlock Name="TestText" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="False" AutomationProperties.Name="Test result" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Name="UseButton" Content="Use these settings" FontSize="12" Click="OnUseClicked" />
                <TextBlock Name="SavedText" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" IsVisible="False" AutomationProperties.Name="Saved" />
            </StackPanel>

            <TextBlock Text="Getting a model" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
            <ItemsControl Name="InstallLines">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <SelectableTextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,3" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <SelectableTextBlock Name="CloudText" FontSize="11.5" TextWrapping="Wrap" AutomationProperties.Name="Ollama's cloud" />
        </StackPanel>
    </ScrollViewer>
</Window>
