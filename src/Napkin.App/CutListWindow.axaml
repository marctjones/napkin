<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewing="clr-namespace:Napkin.App.Viewing"
        mc:Ignorable="d" d:DesignWidth="640" d:DesignHeight="460"
        x:Class="Napkin.App.CutListWindow"
        Title="Cut list"
        Icon="/Assets/napkin-256.png"
        Width="880" Height="480"
        MinWidth="420" MinHeight="240">

    <!--
        The cut list is what a person reads at the bench: the parts, how many of each, how big and
        out of what. The table is sortable by every column and the numbers never change when it is
        sorted — sorting reorders what is shown, nothing else.
    -->
    <DockPanel Margin="12">

        <TextBlock Name="DesignHeadline"
                   DockPanel.Dock="Top"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />

        <!-- Two lists of one design, one tab each: the cut list drives the shop, the shopping list
             drives the store run (issue #9). They sit side by side as tabs so that each is plainly
             its own list, with its own columns and its own statement of what it is before. -->
        <TabControl Name="Lists" Margin="0,6,0,0">
            <TabItem Name="CutListTab" Header="Cut list" FontSize="14">
                <DockPanel>
                    <!-- Said on the table as well as in the exported file, rather than left for someone to
                         find out at the saw (docs/design/parts-and-cut-list.md §1.3). -->
                    <TextBlock Name="KerfNote"
                               DockPanel.Dock="Top"
                               Margin="0,4,0,10"
                               FontSize="11"
                               Opacity="0.75"
                               TextWrapping="Wrap" />

                    <Border Name="EmptyNote"
                            DockPanel.Dock="Bottom"
                            IsVisible="False"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            CornerRadius="4"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                        <TextBlock Name="EmptyText"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Rough rows, said under the table (sketch-mode §5). -->
                    <TextBlock Name="RoughNote"
                               DockPanel.Dock="Bottom"
                               IsVisible="False"
                               Margin="0,8,0,0"
                               FontSize="11"
                               FontStyle="Italic"
                               TextWrapping="Wrap" />

                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <viewing:CutListTable Name="Table" />
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Name="ShoppingListTab" Header="Shopping list" FontSize="14">
                <DockPanel>
                    <!-- No kerf, no defect, no joinery: said here as the cut list says it
                         (docs/design/parts-and-cut-list.md §4). -->
                    <TextBlock Name="ShoppingNote"
                               DockPanel.Dock="Top"
                               Margin="0,4,0,10"
                               FontSize="11"
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                    <!-- Renovation (renovation-sketches §6.2): only what is New is bought; said only when
                         the design has something existing or coming out. -->
                    <TextBlock Name="RenovationNote"
                               DockPanel.Dock="Top"
                               IsVisible="False"
                               Margin="0,0,0,8"
                               FontSize="11"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="Only what is New" />

                    <!-- No horizontal scrolling, so the note column takes what width is left and wraps
                         a refusal onto a second line instead of running off the edge. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">
                            <viewing:ShoppingListTable Name="ShoppingTable" />
                            <TextBlock Name="ShoppingRoughNote"
                                       IsVisible="False"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       FontStyle="Italic"
                                       TextWrapping="Wrap" />
                            <!-- An estimate from prices the person typed (#141): a price per line to buy,
                                 remembered in the settings; never a price napkin carries. -->
                            <StackPanel Name="PriceSection" Spacing="3" IsVisible="False">
                                <TextBlock Text="Prices" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                           Text="Type what you pay for each: a board of that length, a sheet, or a board foot. napkin knows no prices." />
                                <StackPanel Name="PriceRows" Spacing="2" />
                                <TextBlock Name="EstimateText" FontSize="12" FontWeight="SemiBold" AutomationProperties.Name="Estimate" />
                            </StackPanel>
                            <!-- The walls' framing (#18): derived from the walls and openings, bought through
                                 the same aggregation as the parts, and shown apart from them. -->
                            <StackPanel Name="FramingSection" Spacing="4" IsVisible="False">
                                <TextBlock Text="Framing" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Name="FramingNote" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                <viewing:ShoppingListTable Name="FramingTable" />
                            </StackPanel>
                            <!-- Each deck's frame, bought as boards (deck-and-porch §2.4): its own section. -->
                            <StackPanel Name="DeckSection" Spacing="4" IsVisible="False">
                                <TextBlock Text="Deck" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Name="DeckNote" FontSize="11" Opacity="0.75" TextWrapping="Wrap" AutomationProperties.Name="Deck note" />
                                <viewing:ShoppingListTable Name="DeckTable" />
                            </StackPanel>
                            <!-- A porch roof's rafters, ledger and blocking, its coverings and the sunroom test (deck-and-porch §8). -->
                            <StackPanel Name="RoofSection" Spacing="4" IsVisible="False">
                                <TextBlock Text="Roof" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Name="RoofNote" FontSize="11" Opacity="0.75" TextWrapping="Wrap" AutomationProperties.Name="Roof note" />
                                <viewing:ShoppingListTable Name="RoofTable" />
                                <TextBlock Name="SunroomLine" FontSize="11" TextWrapping="Wrap" AutomationProperties.Name="Sunroom test" />
                            </StackPanel>
                            <!-- A room's finishes by area (renovation-sketches §5): each line rounds once, and says
                                 the typed values it used. -->
                            <StackPanel Name="AreaTakeoffSection" Spacing="2" IsVisible="False">
                                <TextBlock Text="Area takeoff" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Name="AreaTakeoffNote" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                           Text="By area from the drawn room, each line rounded once at its end; the sizes and coverages are the ones you typed from the packages." />
                                <ItemsControl Name="AreaTakeoffList" FontSize="12" AutomationProperties.Name="Area takeoff" />
                            </StackPanel>
                            <!-- The rough-in notes, counted by symbol (renovation-sketches §6.2): never modelled. -->
                            <StackPanel Name="NotesSection" Spacing="2" IsVisible="False">
                                <TextBlock Text="Notes" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Name="NotesLine" FontSize="12" TextWrapping="Wrap" AutomationProperties.Name="Notes" />
                            </StackPanel>
                            <TextBlock Name="ExtrasNote"
                                       Margin="0,14,0,4"
                                       FontSize="11"
                                       Opacity="0.75"
                                       TextWrapping="Wrap" />
                            <viewing:ExtrasTable Name="ExtrasGrid" />
                            <!-- What comes out (renovation-sketches §6.2): a count, never a dumpster size. -->
                            <StackPanel Name="DemolitionSection" Spacing="2" IsVisible="False">
                                <TextBlock Text="Demolition" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold" />
                                <ItemsControl Name="DemolitionList" FontSize="12" AutomationProperties.Name="Demolition" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- Which piece from which board (issue #138): the boards the shopping list buys, with the pieces
                 in cutting order, the saw kerf and the offcut. The kerf is the person's own setting. -->
            <TabItem Name="CutLayoutTab" Header="Cut layout" FontSize="14">
                <DockPanel>
                    <TextBlock Name="LayoutNote"
                               DockPanel.Dock="Top"
                               Margin="0,4,0,6"
                               FontSize="11"
                               Opacity="0.75"
                               TextWrapping="Wrap" />
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,2">
                        <TextBlock Text="Saw kerf" VerticalAlignment="Center" FontSize="12" />
                        <TextBox Name="KerfBox" Width="90" FontSize="12" AutomationProperties.Name="Saw kerf" />
                        <Button Name="SetKerfButton" Content="Set" FontSize="12" AutomationProperties.Name="Set saw kerf" />
                        <TextBlock Name="KerfHint" VerticalAlignment="Center" FontSize="11" Opacity="0.75"
                                   Text="practice default: set your blade's actual kerf (0 is allowed)" />
                    </StackPanel>
                    <TextBlock Name="KerfError"
                               DockPanel.Dock="Top"
                               FontSize="11"
                               IsVisible="False"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemErrorTextColor}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="4">
                            <viewing:CutLayoutView Name="LayoutView" />
                            <TextBlock Name="LayoutSummary" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Name="FramingLayoutSection" Spacing="4" IsVisible="False">
                                <TextBlock Text="Framing" Margin="0,14,0,0" FontSize="12" FontWeight="SemiBold" />
                                <viewing:CutLayoutView Name="FramingLayoutView" />
                                <TextBlock Name="FramingLayoutSummary" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- What only the builder can say: a size for each kind of fastener in each thickness, and
                 the shopping list's checklist. Typed text, never napkin's data (joinery note §7.3, §8). -->
            <TabItem Name="SizesTab" Header="Fastener sizes and supplies" FontSize="14">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="8" Margin="0,6,0,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Fastener sizes" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="Type the size you will use for each kind of fastener in each stock thickness, and how many come in a pack. Napkin never fills these in; the ones still blank are first." />
                        <StackPanel Name="SizeRows" Spacing="4" />
                        <TextBlock Name="SizesError" FontSize="11" IsVisible="False" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SystemErrorTextColor}" />
                        <Button Name="SaveSizesButton" Content="Save sizes" HorizontalAlignment="Left"
                                AutomationProperties.Name="Save fastener sizes" />

                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Supplies" Margin="0,12,0,0" />
                        <TextBlock FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                   Text="One line per supply, with an optional note after a vertical bar, like: Finish | one quart. Napkin adds only the glue line." />
                        <TextBox Name="SuppliesBox" AcceptsReturn="True" MinHeight="90" FontSize="12"
                                 AutomationProperties.Name="Supplies" />
                        <Button Name="SaveSuppliesButton" Content="Save supplies" HorizontalAlignment="Left"
                                AutomationProperties.Name="Save supplies" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
