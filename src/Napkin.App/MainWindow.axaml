<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewing="clr-namespace:Napkin.App.Viewing"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="740"
        x:Class="Napkin.App.MainWindow"
        Title="napkin"
        Width="1100" Height="740"
        MinWidth="560" MinHeight="380">

    <!--
        The shell is three things and no more: a menu, the drawing, and a line saying where you
        are. M1 is a viewer, so there is nothing else a person could do here, and a toolbar of
        disabled buttons would be a promise rather than a tool.
    -->
    <DockPanel>

        <Menu Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Name="FileMenu" Header="_File">
                <MenuItem Name="OpenMenuItem"
                          Header="_Open…"
                          Click="OnOpenClicked"
                          ToolTip.Tip="Open a napkin scene file. A file this build cannot read is refused, and whatever is on screen stays." />
                <Separator />
                <MenuItem Name="ExitMenuItem" Header="E_xit" Click="OnExitClicked" />
            </MenuItem>

            <!-- Samples are built from SampleFiles.All in the code-behind: one item per scene file
                 that shipped beside the executable, opened through the same reader as any other
                 file. -->
            <MenuItem Name="SamplesMenu" Header="_Samples" />

            <MenuItem Name="ViewMenu" Header="_View">
                <MenuItem Name="ZoomToFitMenuItem" Header="Zoom to _Fit" Click="OnZoomToFitClicked" />
                <MenuItem Name="ZoomInMenuItem" Header="Zoom _In" Click="OnZoomInClicked" />
                <MenuItem Name="ZoomOutMenuItem" Header="Zoom _Out" Click="OnZoomOutClicked" />
            </MenuItem>
        </Menu>

        <Border Name="StatusBar"
                DockPanel.Dock="Bottom"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                Padding="12,5">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Name="DesignText"
                           Grid.Column="0"
                           FontSize="12"
                           Opacity="0.75"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Name="CursorText"
                           Grid.Column="1"
                           FontSize="12"
                           Margin="16,0"
                           MinWidth="190"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
                <TextBlock Name="ZoomText"
                           Grid.Column="2"
                           FontSize="12"
                           MinWidth="86"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!--
            The canvas fills what is left, and the refusal panel floats over the top of it rather
            than docking beside it. That is deliberate: a docked panel would change the canvas's
            arranged size, which would move the view transform, and "the drawing you had is exactly
            as you left it" is the whole promise of a refusal.
        -->
        <Panel>
            <viewing:CanvasView Name="DrawingCanvas" />

            <!-- Its colours come from the canvas palette in the code-behind, not from a theme
                 resource: the panel sits on the drawing, so it should be lit the same way, and a
                 resource name that failed to resolve would leave it with no background at all —
                 unreadable, and not even clickable to dismiss. -->
            <Border Name="RefusalPanel"
                    IsVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="16"
                    Padding="14,11"
                    CornerRadius="4"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Name="RefusalHeadline"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <StackPanel Name="RefusalProblemList" Spacing="3" />
                    <TextBlock Name="RefusalDismissHint"
                               Text="Press Escape, or click this message, to dismiss it."
                               FontSize="11"
                               Opacity="0.7"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Panel>

    </DockPanel>
</Window>
