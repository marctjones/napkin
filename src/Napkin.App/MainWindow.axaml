<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewing="clr-namespace:Napkin.App.Viewing"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="740"
        x:Class="Napkin.App.MainWindow"
        Title="napkin"
        Width="1100" Height="740"
        MinWidth="560" MinHeight="380">

    <!--
        The shell is a menu, the drawing, and a line saying where you are. The editing chrome — the
        tool control, the relationship list, the dimension a person is typing into — floats over
        the drawing rather than docking beside it, so the canvas still fills everything the menu
        and the status line leave. That is not decoration: docking a panel would change the
        canvas's arranged size, and the view transform is arranged size.
    -->
    <DockPanel>

        <Menu Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Name="FileMenu" Header="_File">
                <MenuItem Name="NewMenuItem"
                          Header="_New"
                          Click="OnNewClicked"
                          ToolTip.Tip="Start a blank sheet. Press R and drag to draw a part." />
                <MenuItem Name="OpenMenuItem"
                          Header="_Open…"
                          Click="OnOpenClicked"
                          ToolTip.Tip="Open a napkin scene file. A file this build cannot read is refused, and whatever is on screen stays." />
                <Separator />
                <MenuItem Name="ExitMenuItem" Header="E_xit" Click="OnExitClicked" />
            </MenuItem>

            <MenuItem Name="DrawMenu" Header="_Draw">
                <MenuItem Name="SelectToolMenuItem" Header="_Select" Click="OnSelectToolClicked" />
                <MenuItem Name="RectangleToolMenuItem" Header="_Rectangle" Click="OnRectangleToolClicked" />
                <MenuItem Name="StockToolboxMenuItem"
                          Header="Stoc_k toolbox"
                          Click="OnStockToolboxClicked"
                          ToolTip.Tip="Pick a real stock size — a 2x4, a sheet of plywood — and drag it onto the paper." />
                <Separator />
                <MenuItem Name="ShapeMenuItem"
                          Header="S_hape…"
                          Click="OnShapeClicked"
                          ToolTip.Tip="Open the selected part in the shape workshop: pick its stock and cut its corners and edges." />
                <MenuItem Name="DuplicateMenuItem" Header="D_uplicate" Click="OnDuplicateClicked" />
                <MenuItem Name="PinMenuItem" Header="_Pin in place" Click="OnPinClicked" />
                <MenuItem Name="DeleteMenuItem" Header="_Delete" Click="OnDeleteClicked" />
            </MenuItem>

            <!-- Samples are built from SampleFiles.All in the code-behind: one item per scene file
                 that shipped beside the executable, opened through the same reader as any other
                 file. -->
            <MenuItem Name="SamplesMenu" Header="Sa_mples" />

            <MenuItem Name="ViewMenu" Header="_View">
                <MenuItem Name="ZoomToFitMenuItem" Header="Zoom to _Fit" Click="OnZoomToFitClicked" />
                <MenuItem Name="ZoomInMenuItem" Header="Zoom _In" Click="OnZoomInClicked" />
                <MenuItem Name="ZoomOutMenuItem" Header="Zoom _Out" Click="OnZoomOutClicked" />
                <Separator />
                <MenuItem Name="CutListMenuItem"
                          Header="_Cut list"
                          Click="OnCutListClicked"
                          ToolTip.Tip="Every piece this design says to cut, grouped and sorted. It follows the drawing as it is edited." />
            </MenuItem>
        </Menu>

        <Border Name="StatusBar"
                DockPanel.Dock="Bottom"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel>

                <!-- Every update result lands here and stays until the next edit: what was done,
                     what could not be done and why, and — when a conflict has a way out — the
                     offer to take it (CVS-008). -->
                <Border Name="MessageBar"
                        IsVisible="False"
                        Padding="12,6"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Name="MessageText"
                                   Grid.Column="0"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Name="MessageOfferButton"
                                Grid.Column="1"
                                IsVisible="False"
                                Margin="12,0,0,0"
                                Padding="8,3"
                                FontSize="12"
                                Click="OnMessageOfferClicked" />
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,Auto,Auto" Margin="12,5">
                    <TextBlock Name="DesignText"
                               Grid.Column="0"
                               FontSize="12"
                               Opacity="0.75"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Name="CursorText"
                               Grid.Column="1"
                               FontSize="12"
                               Margin="16,0"
                               MinWidth="190"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                    <TextBlock Name="ZoomText"
                               Grid.Column="2"
                               FontSize="12"
                               MinWidth="86"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!--
            The canvas fills what is left, and everything else floats over the top of it rather
            than docking beside it.
        -->
        <Panel>
            <viewing:CanvasView Name="DrawingCanvas" />

            <!--
                The shape workshop (docs/design/shaped-parts-model.md §7.1): a sheet over the
                drawing, not a second window and not a second document. It is a mode the window is
                in, the way the rectangle tool is a mode, and it covers the canvas because its
                whole job is to give one blank the room a canvas tool does not have — the part
                drawn large and unrotated, its corners named, and its cuts listed beside it.

                §7.2 says a selected cut's numbers show "in the properties panel". While the
                workshop is open, the panel beside the blank *is* that panel: it lists the cuts
                and holds the typed fields for the selected one, which is also §7.1's "the list
                of cuts with their typed values beside it". The canvas's own properties panel is
                hidden for the duration, along with the tool control and the relationship list —
                two panels stacked on the same corner of the window would have one of them taking
                the other's clicks, and the workshop already says what the part is and what it is
                cut from.
            -->
            <Border Name="WorkshopSheet" IsVisible="False" BorderThickness="0">
                <Grid RowDefinitions="Auto,*,Auto">

                    <StackPanel Grid.Row="0" Spacing="6" Margin="14,10,14,6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Name="WorkshopHeadline"
                                       Grid.Column="0"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <Button Name="WorkshopDoneButton"
                                    Grid.Column="1"
                                    Content="Done"
                                    FontSize="12"
                                    Padding="12,3"
                                    Click="OnWorkshopDoneClicked"
                                    ToolTip.Tip="Back to the drawing, with the part where it was. Escape does the same." />
                        </Grid>

                        <!-- The stock picker leads, because the normal way to start a shaped part
                             is to say what it is cut from (§1.2). -->
                        <Grid ColumnDefinitions="Auto,200,Auto,*">
                            <TextBlock Grid.Column="0" Text="Cut from" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Name="WorkshopStockBox" Grid.Column="1" FontSize="12"
                                     PlaceholderText="Stock, e.g. 1x6" />
                            <Button Name="WorkshopStockButton"
                                    Grid.Column="2"
                                    Content="Use this stock"
                                    FontSize="12"
                                    Padding="10,3"
                                    Margin="6,0,0,0"
                                    Click="OnWorkshopStockClicked" />
                            <TextBlock Name="WorkshopStockReadout"
                                       Grid.Column="3"
                                       FontSize="10"
                                       Opacity="0.85"
                                       Margin="10,0,0,0"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="1" ColumnDefinitions="*,232">
                        <viewing:WorkshopView Name="WorkshopDrawing" Grid.Column="0" />

                        <Border Name="WorkshopCutsPanel"
                                Grid.Column="1"
                                Margin="8,0,12,0"
                                Padding="10,8"
                                CornerRadius="4"
                                BorderThickness="1">
                            <StackPanel Spacing="5">
                                <TextBlock Name="WorkshopCutsHeadline"
                                           Text="Cuts"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <ListBox Name="WorkshopCutsList"
                                         FontSize="11"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MaxHeight="140" />
                                <TextBlock Name="WorkshopCutsEmpty"
                                           Text="Nothing has been cut off this blank yet."
                                           FontSize="11"
                                           Opacity="0.75"
                                           TextWrapping="Wrap" />

                                <!--
                                    The selected cut's numbers, while the shape workshop is open
                                    (docs/design/shaped-parts-model.md §7.2). Typing one is a SetCut with the
                                    new value — the "resize by typing a dimension" pattern applied to a cut —
                                    and an angle typed for a corner cut is converted to the setback it implies
                                    with one explicit rounding.
                                -->
                                <StackPanel Name="CutFields" Spacing="5" IsVisible="False">
                                    <Border Height="1"
                                            Name="CutFieldsRule"
                                            Margin="0,2"
                                            BorderThickness="0,1,0,0" />

                                    <TextBlock Name="CutHeadline" FontSize="12" FontWeight="SemiBold" />

                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Name="CutFirstCaption" Grid.Row="0" Grid.Column="0"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Name="CutFirstBox" Grid.Row="0" Grid.Column="1" FontSize="12"
                                                 Margin="0,0,0,4" />

                                        <TextBlock Name="CutSecondCaption" Grid.Row="1" Grid.Column="0"
                                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Name="CutSecondBox" Grid.Row="1" Grid.Column="1" FontSize="12"
                                                 Margin="0,0,0,4" />

                                        <TextBlock Name="CutAngleCaption" Grid.Row="2" Grid.Column="0"
                                                   Text="Angle" FontSize="11"
                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Name="CutAngleBox" Grid.Row="2" Grid.Column="1" FontSize="12"
                                                 PlaceholderText="45" />
                                    </Grid>

                                    <TextBlock Name="CutReadout" FontSize="10" Opacity="0.85" TextWrapping="Wrap" />

                                    <TextBlock Name="CutError"
                                               IsVisible="False"
                                               FontSize="11"
                                               TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                        <Button Name="FullMitreButton"
                                                Content="Full mitre"
                                                FontSize="11"
                                                Padding="8,3"
                                                Click="OnFullMitreClicked"
                                                ToolTip.Tip="Both setbacks at the blank's width, once. It does not keep them related afterwards." />
                                        <Button Name="RemoveCutButton"
                                                Content="Remove"
                                                FontSize="11"
                                                Padding="8,3"
                                                Click="OnRemoveCutClicked" />
                                        <Button Name="ApplyCutButton"
                                                Content="Apply"
                                                FontSize="11"
                                                Padding="8,3"
                                                Click="OnApplyCutClicked" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Name="WorkshopHint"
                               Grid.Row="2"
                               Margin="14,4,14,10"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- The dimension a person is typing into sits on the drawing, over the label it is
                 editing. The host Canvas has no background, so it is not hit-testable and the
                 drawing underneath still takes every click that is not on the field itself. -->
            <Canvas Name="EditorOverlay">
                <Border Name="DimensionEditor"
                        IsVisible="False"
                        Padding="6,5"
                        CornerRadius="4"
                        BorderThickness="1">
                    <StackPanel Spacing="4" MinWidth="150">
                        <TextBlock Name="DimensionEditorCaption" FontSize="11" FontWeight="SemiBold" />
                        <TextBox Name="DimensionEntryBox"
                                 FontSize="13"
                                 Width="150"
                                 PlaceholderText="3' 4 1/2&quot;" />
                        <TextBlock Name="DimensionEditorError"
                                   IsVisible="False"
                                   FontSize="11"
                                   MaxWidth="230"
                                   TextWrapping="Wrap" />
                        <TextBlock Name="DimensionEditorHint"
                                   Text="Enter applies it. Escape leaves it alone."
                                   FontSize="10"
                                   Opacity="0.7" />
                    </StackPanel>
                </Border>
            </Canvas>

            <Border Name="ToolBar"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="10"
                    Padding="4"
                    CornerRadius="4"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <ToggleButton Name="SelectToolButton"
                                  Content="Select"
                                  FontSize="12"
                                  Padding="10,4"
                                  Click="OnSelectToolClicked"
                                  ToolTip.Tip="Pick, move and resize parts (S)" />
                    <ToggleButton Name="RectangleToolButton"
                                  Content="Rectangle"
                                  FontSize="12"
                                  Padding="10,4"
                                  Click="OnRectangleToolClicked"
                                  ToolTip.Tip="Drag out a new part (R)" />
                    <ToggleButton Name="StockToolButton"
                                  Content="Stock"
                                  FontSize="12"
                                  Padding="10,4"
                                  Click="OnStockToolboxClicked"
                                  ToolTip.Tip="Pick real stock from the toolbox and drag it onto the paper (M)" />
                </StackPanel>
            </Border>

            <!-- The stock toolbox (issue #7's picker): category icons, then a text list, then a
                 drag on the paper places a part already cut from the item picked. It floats under
                 the tool control it is opened from, and stays open while parts are placed. -->
            <viewing:StockToolbox Name="StockToolboxPanel"
                                  IsVisible="False"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="10,56,10,10" />

            <!-- What the drawing says about itself, in words. Read-only on purpose, and not
                 hit-testable, so it never takes a click or a wheel turn meant for the drawing.
                 On demand (#62): a small count badge until a part that has relationships is
                 selected or under the pointer, and only then the sentences themselves. -->
            <Border Name="RelationshipsPanel"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="10"
                    Padding="10,8"
                    MaxWidth="260"
                    MaxHeight="320"
                    CornerRadius="4"
                    BorderThickness="1">
                <StackPanel Spacing="5">
                    <TextBlock Name="RelationshipsHeadline"
                               Text="Relationships"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <StackPanel Name="RelationshipsList" Spacing="3" IsVisible="False" />
                </StackPanel>
            </Border>

            <!--
                What the selected part is, as opposed to where it is: its name, the one dimension
                the plan cannot hold, which of the three the drawing is showing, and what stock it
                is cut from. This is the only way a box somebody drew becomes a piece somebody
                cuts (docs/design/parts-and-cut-list.md §1).
            -->
            <Border Name="PropertiesPanel"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="10"
                    Padding="10,8"
                    Width="248"
                    CornerRadius="4"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Name="PropertiesHeadline"
                               Text="Part"
                               FontSize="12"
                               FontWeight="SemiBold" />

                    <TextBox Name="PartNameBox" FontSize="12" PlaceholderText="Name" />

                    <CheckBox Name="IsPartCheck"
                              Content="This is a piece to cut"
                              FontSize="12"
                              IsCheckedChanged="OnIsPartChanged"
                              ToolTip.Tip="A wall or an opening is a box nobody cuts, and stays off the cut list." />

                    <StackPanel Name="PartFields" Spacing="6" IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Across" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Name="PlanXBox" Grid.Row="0" Grid.Column="1" FontSize="12"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Up" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox Name="PlanYBox" Grid.Row="1" Grid.Column="1" FontSize="12"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,4" />

                            <TextBlock Name="OutOfPlaneCaption" Grid.Row="2" Grid.Column="0"
                                       Text="Thickness" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Name="OutOfPlaneBox" Grid.Row="2" Grid.Column="1" FontSize="12"
                                     PlaceholderText="3/4&quot;" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Qty" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Name="QuantityBox" Grid.Row="3" Grid.Column="1" FontSize="12"
                                     PlaceholderText="1" />
                        </Grid>

                        <TextBox Name="StockBox" FontSize="12" PlaceholderText="Stock, e.g. 2x4" />
                        <TextBlock Name="StockReadout" FontSize="10" Opacity="0.8" TextWrapping="Wrap" />
                        <TextBox Name="SpeciesBox" FontSize="12" PlaceholderText="Species" />
                    </StackPanel>

                    <Button Name="ApplyPartButton"
                            Content="Apply"
                            FontSize="12"
                            Padding="10,3"
                            HorizontalAlignment="Right"
                            Click="OnApplyPartClicked" />

                    <TextBlock Name="PropertiesError"
                               IsVisible="False"
                               FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Its colours come from the canvas palette in the code-behind, not from a theme
                 resource: the panel sits on the drawing, so it should be lit the same way, and a
                 resource name that failed to resolve would leave it with no background at all —
                 unreadable, and not even clickable to dismiss. -->
            <Border Name="RefusalPanel"
                    IsVisible="False"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Margin="16"
                    Padding="14,11"
                    CornerRadius="4"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Name="RefusalHeadline"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <StackPanel Name="RefusalProblemList" Spacing="3" />
                    <TextBlock Name="RefusalDismissHint"
                               Text="Press Escape, or click this message, to dismiss it."
                               FontSize="11"
                               Opacity="0.7" />
                </StackPanel>
            </Border>
        </Panel>

    </DockPanel>
</Window>
