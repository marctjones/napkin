<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\napkin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Napkin.Core.Geometry\Napkin.Core.Geometry.csproj" />
    <ProjectReference Include="..\Napkin.Modules.Furniture\Napkin.Modules.Furniture.csproj" />
    <ProjectReference Include="..\Napkin.Modules.Building\Napkin.Modules.Building.csproj" />
    <ProjectReference Include="..\Napkin.Interop.Dxf\Napkin.Interop.Dxf.csproj" />
    <ProjectReference Include="..\Napkin.Interop.SketchUp\Napkin.Interop.SketchUp.csproj" />
    <ProjectReference Include="..\Napkin.Interop.Pdf\Napkin.Interop.Pdf.csproj" />
    <ProjectReference Include="..\Napkin.Core.Project\Napkin.Core.Project.csproj" />
  </ItemGroup>

  <!-- The app's icon, and the design system's fonts (docs/third-party-notices.md). The three OFL
       license files ship next to the executable as well as inside it: the license requires its
       notice to travel with every copy of the fonts, and a person should be able to find it without
       unpacking a resource. -->
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="Assets\Fonts\LICENSE-IBM-Plex-*.txt"
             Link="licenses\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The samples ship inside the build. They are the app's samples, not test data: the Samples
       menu opens these files through the scene reader, so a machine that has never seen this
       repository gets the same two drawings from the same bytes the fixtures are checked against
       (samples/README.md). CopyToPublishDirectory is stated rather than left to the default so
       that a `dotnet publish` layout is covered as explicitly as the build output is. -->
  <ItemGroup>
    <Content Include="..\..\samples\*.scene.json"
             Link="samples\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The code packs ship beside the executable (packs/layers, packs/packs), like the samples. The
       app looks there and in the per-user <config>/napkin/packs (docs/rules-engine.md). -->
  <ItemGroup>
    <Content Include="..\..\packs\**\*"
             Link="packs\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
