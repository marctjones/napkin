<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The executable is called `napkin`, never `Napkin.App`. macOS 26 kills, at launch and with
         no message (exit 137), any executable FILE whose name ends in `.app`: it takes it for a
         malformed application bundle. A trivial program renamed `hello.App` dies the same way and
         the same bytes named `napkin-viewer` run. Found with the first downloadable build
         (issue #56). The project keeps its name; only the assembly and so the apphost change. -->
    <AssemblyName>napkin</AssemblyName>
    <RootNamespace>Napkin.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Napkin.Core.Geometry\Napkin.Core.Geometry.csproj" />
    <ProjectReference Include="..\Napkin.Modules.Furniture\Napkin.Modules.Furniture.csproj" />
    <ProjectReference Include="..\Napkin.Modules.Building\Napkin.Modules.Building.csproj" />
    <ProjectReference Include="..\Napkin.Interop.Dxf\Napkin.Interop.Dxf.csproj" />
    <ProjectReference Include="..\Napkin.Interop.SketchUp\Napkin.Interop.SketchUp.csproj" />
    <ProjectReference Include="..\Napkin.Interop.Pdf\Napkin.Interop.Pdf.csproj" />
    <ProjectReference Include="..\Napkin.Core.Project\Napkin.Core.Project.csproj" />
  </ItemGroup>

  <!-- The samples ship inside the build. They are the app's samples, not test data: the Samples
       menu opens these files through the scene reader, so a machine that has never seen this
       repository gets the same two drawings from the same bytes the fixtures are checked against
       (samples/README.md). CopyToPublishDirectory is stated rather than left to the default so
       that a `dotnet publish` layout is covered as explicitly as the build output is. -->
  <ItemGroup>
    <Content Include="..\..\samples\*.scene.json"
             Link="samples\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
