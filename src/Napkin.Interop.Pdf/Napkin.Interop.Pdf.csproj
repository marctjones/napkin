<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Napkin.Modules.Editing\Napkin.Modules.Editing.csproj" />
  </ItemGroup>

  <!-- Excise.Core comes from vendor/excise, never nuget.org (nuget.config). The version names the
       pushed excise commit it was packed from; tools/scripts/excise-pack.sh moves it. Its CSJ2K
       dependency is pruned for every project (Directory.Build.targets says why); what remains is
       BouncyCastle.Cryptography, MIT. -->
  <ItemGroup>
    <PackageReference Include="Excise.Core" Version="3.1.0-napkin.g9501059" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
