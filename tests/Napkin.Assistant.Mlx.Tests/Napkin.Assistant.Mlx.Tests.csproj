<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The marshalling tests build the bridge's structs in unmanaged memory, as the bridge would. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Every test drives the runtime through FakeNativeMlx: nothing here loads libNapkinMlx.dylib,
       needs Metal or reads a model's weights (docs/design/mlx-runtime.md §7.2). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Napkin.Assistant.Mlx\Napkin.Assistant.Mlx.csproj" />
  </ItemGroup>

</Project>
