<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Synthetic fixture packs and golden files (SYNTHETIC TEST DATA - NOT CODE VALUES), read from
       disk by the same loader path a person's own pack directory uses. -->
  <ItemGroup>
    <Content Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Golden/**/*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The wall-bracing packs A and B and their golden files (SYNTHETIC TEST DATA - NOT CODE VALUES),
         shared with the building module's and the GUI suite's tests. -->
    <Content Include="..\Napkin.Modules.Building.Tests\CodePacks\brace\**\*" Link="BracePacks\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The real shipped packs (packs/ at the repo root), copied so tests read them from disk. -->
    <Content Include="..\..\packs\**\*" Link="RealPacks\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Napkin.Core.RulesEngine\Napkin.Core.RulesEngine.csproj" />
  </ItemGroup>

</Project>
