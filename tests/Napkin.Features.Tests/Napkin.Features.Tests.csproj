<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The feature checklist as a test project (issue #34). Its one source file is generated by
    `scorecard stubs`, which writes one skipped fact per catalogued feature that no hand-written
    test claims yet. Real tests belong in the test project for the code they exercise, not here.
    See docs/testing/scorecard.md for the exact command.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
