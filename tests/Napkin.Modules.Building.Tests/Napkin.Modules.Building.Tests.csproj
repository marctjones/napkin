<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Napkin.Modules.Building\Napkin.Modules.Building.csproj" />
  </ItemGroup>

  <!-- The wall-with-window sample is this suite's worked example, so its scene and its hand-derived
       expectations travel with the test binary rather than being found by walking up to the
       repository root (samples/README.md). -->
  <ItemGroup>
    <Content Include="..\..\samples\*.json"
             Link="samples\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Synthetic packs roots (SYNTHETIC TEST DATA - NOT CODE VALUES) and the real shipped packs, read
       from disk by the loader path the app uses. -->
  <ItemGroup>
    <Content Include="CodePacks/**/*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\packs\**\*" Link="RealPacks\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
