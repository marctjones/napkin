<Project>

  <!-- The one place napkin's version is set (DESIGN.md §12). The minor number N is bumped by the
       pull request that lands the work, by its author; patch stays 0. Every assembly and the app
       report 0.N.0-beta. CI adds the commit SHA to the informational version. -->
  <PropertyGroup>
    <VersionPrefix>0.3.0</VersionPrefix>
    <VersionSuffix>beta</VersionSuffix>
  </PropertyGroup>

</Project>
