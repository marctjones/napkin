<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for napkin (#25). Everything comes from nuget.org except Excise.Core, the PDF
  library from marctjones/excise, which is deliberately not published there (excise's
  Packaging.props, excise #383/#384). napkin vendors one nupkg packed from a pushed excise commit
  into vendor/excise; tools/scripts/excise-pack.sh makes a new one and moves the pin.

  The source mapping is not decoration: Excise.* may only come from vendor/excise, so a package of
  the same name published to nuget.org by anyone else can never be restored in its place.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="excise" value="vendor/excise" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="excise">
      <package pattern="Excise.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
